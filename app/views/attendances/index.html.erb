<h1 class="text-xl font-bold mb-4">今月の月報</h1>

<div class="mb-3 flex items-center gap-3">
  <% prev = (@month - 1.month).beginning_of_month %>
  <% nextm = (@month + 1.month).beginning_of_month %>
  <%= link_to "« 前月", user_attendances_path(month: prev.to_s), class: "text-blue-700 underline" %>
  <span><%= @month.strftime("%Y年%m月") %></span>
  <%= link_to "翌月 »", user_attendances_path(month: nextm.to_s), class: "text-blue-700 underline" %>
  <div class="ml-auto">
    <%= link_to "本日へ", root_path, class: "text-blue-700 underline" %>
  </div>
</div>

<table class="w-full border text-sm">
  <thead class="bg-gray-100">
    <tr>
      <th class="border px-2 py-1">日付</th>
      <th class="border px-2 py-1">ステータス</th>
      <th class="border px-2 py-1">出勤</th>
      <th class="border px-2 py-1">退勤</th>
      <th class="border px-2 py-1">休憩合計</th>
      <th class="border px-2 py-1">実働</th>
      <th class="border px-2 py-1">修正</th>
    </tr>
  </thead>
  <tbody>
    <% @days.each do |d| %>
      <% a = @att_by_date[d] %>
      <%= render "attendances/row_display", a: a, d: d %>
    <% end %>
  </tbody>
</table>
