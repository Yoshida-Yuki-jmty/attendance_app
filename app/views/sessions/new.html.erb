<meta name="turbolinks-cache-control" content="no-cache">

<section class="max-w-xl mx-auto">
  <div class="bg-white rounded-xl shadow border border-gray-100 p-6">

    <h1 class="text-xl font-bold mb-4">ログイン</h1>

    <%= form_with url: session_path, method: :post, local: true, html: { class: "grid grid-cols-1 gap-5" } do %>
      <div>
        <%= label_tag :email, "（メールアドレス）", class: "font-semibold block mb-1" %>
        <%= email_field_tag :email, params[:email],
              required: true, autocomplete: "email",
              class: "w-full bg-amber-100 text-black font-bold rounded-md py-1 pl-2" %>
      </div>

      <div>
        <%= label_tag :password, "（パスワード）", class: "font-semibold block mb-1" %>
        <%= password_field_tag :password, nil,
              required: true, autocomplete: "current-password",
              class: "w-full bg-amber-100 text-black rounded-md py-1 pl-2" %>
      </div>

      <div class="flex justify-center">
        <%= submit_tag "ログイン",
            class: "px-3 py-1 rounded-2xl tracking-widest font-semibold border-2
                    bg-white text-stone-700 border-cyan-400
                    hover:bg-cyan-100 hover:text-stone-900
                    focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2
                    transition-colors duration-150 ease-in-out
                    disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>
    <% end %>

    <div class="mt-4 flex justify-end">
      <%= link_to "新規登録はこちら", new_user_path, class: "text-blue-700 underline" %>
    </div>
  </div>
</section>
