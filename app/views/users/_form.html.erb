<section class="max-w-xl mx-auto">
  <div class="bg-white rounded-xl shadow border border-gray-100 p-6">
    <%= form_with model: user, local: true, html: { class: "grid grid-cols-1 gap-5" } do |f| %>

      <div>
        <%= f.label :name, "（ユーザー名）", class: "font-semibold block mb-1" %>
        <%= f.text_field :name,
              required: true,
              maxlength: 30,
              class: "w-full bg-amber-100 text-black font-bold text-lg rounded-md py-1 pl-2" %>
      </div>

      <div>
        <%= f.label :email, "（メールアドレス）", class: "font-semibold block mb-1" %>
        <%= f.email_field :email,
              required: true,
              class: "w-full bg-amber-100 text-black font-bold rounded-md py-1 pl-2" %>
      </div>

      <div>
        <%= f.label :password,
              (require_password ? "（パスワード）" : "（パスワード：変更時のみ）"),
              class: "font-semibold block mb-1" %>
        <%= f.password_field :password,
              required: require_password,
              class: "w-full bg-amber-100 text-black rounded-md py-1 pl-2" %>
      </div>

      <div>
        <%= f.label :password_confirmation, "（パスワード確認）", class: "font-semibold block mb-1" %>
        <%= f.password_field :password_confirmation,
              required: require_password,
              class: "w-full bg-amber-100 text-black rounded-md py-1 pl-2" %>
      </div>

<div class="flex justify-center">
  <%= f.submit submit_label,
      class: "px-3 py-1 rounded-2xl tracking-widest font-semibold border-2
              bg-white text-stone-700 border-cyan-400
              hover:bg-cyan-100 hover:text-stone-900
              focus:outline-none focus:ring-2 focus:ring-cyan-300 focus:ring-offset-2
              transition-colors duration-150 ease-in-out
                disabled:opacity-50 disabled:cursor-not-allowed" %>
</div>
    <% end %>

    <% if show_login_link %>
      <div class="mt-4 flex justify-end">
        <%= link_to "ログインはこちら", new_session_path, class: "text-blue-700 underline" %>
      </div>
    <% end %>
  </div>
</section>
