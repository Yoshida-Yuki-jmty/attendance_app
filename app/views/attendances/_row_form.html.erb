<%# 未登録かどうかで送信先を分岐 %>
<% unregistered = attendance.started_at.blank? && attendance.finished_at.blank? && attendance.breaktimes.blank? %>
<% save_url =
    if unregistered
      # 未登録 → attendances#update（未登録だけ保存可）
      user_attendance_path(current_user, attendance, format: :turbo_stream)
    else
      # 登録済み → edit_sessions#update（登録済み保存はこちら）
      user_attendance_edit_session_path(current_user, attendance, format: :turbo_stream)
    end %>


<% form_dom_id = "#{dom_id(attendance)}-form" %>

<tr id="<%= dom_id(attendance) %>" class="bg-amber-50">
  <td class="border border-gray-300 px-2 py-1 align-middle">
    <span class="<%= day_color_class(date) %>"><%= format_jp_md(date) %></span>
  </td>
  <td class="border border-gray-300 px-2 py-1 align-middle text-center">
    <span class="<%= day_color_class(date) %>"><%= format_jp_wday(date) %></span>
  </td>
  <td class="border border-gray-300 px-2 py-1 align-middle">
    <div class="flex items-center justify-center">編集中</div>
  </td>

  <td class="border border-gray-300 px-2 py-1 align-middle">
    <div class="flex justify-center items-center">
      <%= time_field_tag "attendance[started_at_hm]",
            attendance.started_at&.in_time_zone&.strftime("%H:%M"),
            class: "border rounded px-2 py-1 w-24",
            placeholder: "HH:MM",
            form: form_dom_id %>
    </div>
  </td>

  <td class="border border-gray-300 px-2 py-1 align-middle">
    <div class="flex justify-center items-center">
      <%= time_field_tag "attendance[finished_at_hm]",
            attendance.finished_at&.in_time_zone&.strftime("%H:%M"),
            class: "border rounded px-2 py-1 w-24",
            placeholder: "HH:MM",
            form: form_dom_id %>
    </div>
  </td>

  <td class="border border-gray-300 px-2 py-1 align-middle">
    <div class="flex justify-center items-center">
      <% total_sec = attendance.break_seconds.to_i %>
      <% hh = total_sec / 3600; mm = (total_sec % 3600) / 60 %>
      <%= time_field_tag "attendance[break_total_hm]",
            format("%02d:%02d", hh, mm),
            class: "border rounded px-2 py-1 w-24",
            step: 60, min: "00:00", max: "23:59",
            placeholder: "HH:MM",
            form: form_dom_id %>
    </div>
  </td>

  <td class="border border-gray-300 px-2 py-1 align-middle text-gray-400 text-center">—</td>

  <td class="border border-gray-300 py-1 align-middle">
      <div class="flex justify-start items-center gap-x-2 ml-3.5">
      <%= form_with model: [current_user, attendance],
                    id: form_dom_id,
                    url: save_url,
                    method: :patch,
                    data: { turbo: true } do |f| %>
        <div class="flex gap-2 justify-end">
          <%= f.submit "保存", class: "px-2 py-0.5 border rounded bg-emerald-600 text-white" %>

          <%= link_to "破棄",
                user_attendance_edit_session_path(current_user, attendance, format: :turbo_stream),
                data: { turbo_method: :delete },
                class: "px-2 py-0.5 border rounded bg-gray-500 text-white" %>
        </div>
      <% end %>
    </td>
  </div>
</tr>

