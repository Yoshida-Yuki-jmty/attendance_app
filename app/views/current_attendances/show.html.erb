<h1 class="text-3xl font-bold text-center mb-4">本日の日報</h1>

<% date = (@current_attendance&.work_date || business_today) %>
<p class="mb-3 text-right text-gray-600">
  今日は <%= date.strftime("%-m月%-d日") %>（<%= %w(日 月 火 水 木 金 土)[date.wday] %>）です。
</p>

<p class="mb-2">
  現在状況：<%= daily_status_badge(@current_attendance, @opened_break) %>
</p>

<% dis_in   = attendance_button_disabled?(:clock_in,  @current_attendance, @opened_break) %>
<% dis_out  = attendance_button_disabled?(:clock_out, @current_attendance, @opened_break) %>
<% dis_bs   = attendance_button_disabled?(:break_start, @current_attendance, @opened_break) %>
<% dis_be   = attendance_button_disabled?(:break_end,   @current_attendance, @opened_break) %>

<div class="mb-3 flex gap-2">
  <%= button_to "出勤",
        user_current_attendance_path(current_user),
        method: :post,
        disabled: dis_in,
        class: button_ui_class(dis_in) %>

  <%= button_to "退勤",
        (@current_attendance ? user_current_attendance_path(current_user) : "#"),
        method: :patch,
        disabled: dis_out,
        class: button_ui_class(dis_out) %>

  <%= button_to "休憩開始",
        user_breaktimes_path(current_user),
        method: :post,
        disabled: dis_bs,
        class: button_ui_class(dis_bs) %>

  <%= button_to "休憩終了",
        (@opened_break ? user_breaktime_path(current_user, @opened_break) : "#"),
        method: :patch,
        disabled: dis_be,
        class: button_ui_class(dis_be) %>
</div>

<table class="w-full border text-sm">
  <thead class="bg-gray-100">
    <tr>
      <th class="border px-2 py-1">出勤</th>
      <th class="border px-2 py-1">退勤</th>
      <th class="border px-2 py-1">休憩（開始-終了）</th>
      <th class="border px-2 py-1">休憩合計</th>
      <th class="border px-2 py-1">実働</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="border px-2 py-1"><%= format_time_or_dash(@current_attendance&.started_at) %></td>
      <td class="border px-2 py-1"><%= format_time_or_dash(@current_attendance&.finished_at) %></td>
      <td class="border px-2 py-1"><%= breaktimes_html(@current_attendance) %></td>
      <td class="border px-2 py-1"><%= @current_attendance ? format_hhmm_or_dash(@current_attendance.break_seconds)  : "-" %></td>
      <td class="border px-2 py-1"><%= @current_attendance ? format_hhmm_or_dash(@current_attendance.worked_seconds) : "-" %></td>
    </tr>
  </tbody>
</table>

<div class="mt-4 flex justify-end">
  <%= link_to "今月の月報を見る", user_attendances_path(current_user), class: "text-blue-700 underline" %>
</div>
